<h1>Editando: {{user.name}}</h1>
<form action="/users/update" method="post" class="form-edit">
    <input type="hidden" name="id" value="{{user.id}}">
    <div class="form-control">
        <label for="name">nome:</label>
        <input type="text" name="name" placeholder="Digite o nome do usuario" value="{{user.name}}">
    </div>

    <div class="form-control">
        <label for="occupation">nome:</label>
        <input type="text" name="occupation" placeholder="Digite a profissão do usuario" value="{{user.occupation}}">
    </div>

    <div class="form-control form-checkbox">
        {{#if newsletter}}
        <input type="checkbox" name="newsletter" checked>
        {{else}}
        <input type="checkbox" name="newsletter">
        {{/if}}
        <label for="newsletter">Enviar promoções ?</label>

    </div>
    <input type="submit" value="Editar">

</form>
<div class="address-container">
    <h2>Endereço:</h2>
    <form action="/address/create" method="post">
        <input type="hidden" name="UserId" value="{{user.id}}">

        <div class="form-control">
            <label for="street">Rua:</label>
            <input type="text" name="street" placeholder="Digite a rua">
        </div>

        <div class="form-control">
            <label for="number">Número</label>
            <input type="text" name="number" placeholder="Digite o número">
        </div>

        <div class="form-control">
            <label for="city">cidade</label>
            <input type="text" name="city" placeholder="Digite a cidade">
        </div>
        <input type="submit" value="Incluir endereço">
    </form>

    <div class="address-list">
        <h2>Lista de endereços:</h2>
        {{#each user.addresses}}
        <div>
            #{{this.id}} -
            {{this.street}} -
            {{this.number}} -
            {{this.city}}
            <form action="/address/delete" method="POST"></form>
            <input type="hidden" name="UserId" value="{{this.UserId}}">
            <input type="hidden" name="id" value="{{this.id}}">
            <input type="submit" value="Excluir">
        </div>

        {{/each}}

    </div>

</div>