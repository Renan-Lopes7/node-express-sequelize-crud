<h1>Adicione um usuario</h1>
<form action="/users/create" method="post" class="form-add">
    <div class="form-control">
        <label for="name">nome:</label>
        <input type="text" name="name" placeholder="Digite o nome do usuario">
    </div>

    <div class="form-control">
        <label for="occupation">Profissão:</label>
        <input type="text" name="occupation" placeholder="Digite a profissão do usuario">
    </div>

    <div class="form-control form-checkbox">
        <input type="checkbox" name="newsletter" checked>
        <label for="newsletter">Enviar promoções ?</label>

    </div>
    <input type="submit" value="cadastrar">

</form>